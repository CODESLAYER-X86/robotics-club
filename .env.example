# Database connection (Prisma / PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-Side Secrets
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
AUTH_SECRET="your-auth-secret"
SHEETS_SYNC_SECRET="diurc_sec_generate_a_random_32_character_token_here"

# Platform Admin
PLATFORM_ADMIN_EMAIL="admin@diurobotics.com"

# Cloudflare R2 Storage (Used for Gallery Albums - 10GB free, $0 egress)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="diurc-gallery"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev" # or custom domain like https://cdn.diurobotics.com
